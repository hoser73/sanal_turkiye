# Sanal Türkiye — üretim ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp doldurun; .env depoya girmez.
# Sunucu NODE_ENV=production iken eksik ya da güvensiz ayarla AÇILMAZ (server/yapilandirma.js); ayrıntı: docs/yayina-alma.md
NODE_ENV=production
PORT=3400
# docker-compose / Caddy için alan adı; TABAN_URL e-posta bağlantıları, passkey (WebAuthn) ve CSP için
ALAN_ADI=sanalturkiye.ornek.com
TABAN_URL=https://sanalturkiye.ornek.com
VERI_DIZINI=/veri

# Zorunlu: 2FA sırlarını ve telefon numaralarını şifreleyen anahtar (openssl rand -hex 32). Kaybedilirse bunlar çözülemez;
# yedekte yoktur, ayrı ve güvenli saklayın.
SIFRELEME_ANAHTARI=
# Önerilen: silinen hesapların e-posta/telefon özetleri için tuz (openssl rand -hex 16). Yayından önce belirleyin, sonra değiştirmeyin.
SILINEN_KIMLIK_TUZU=

# Zorunlu: e-posta (doğrulama, parola sıfırlama). Örnek: smtps://kullanici:parola@smtp.saglayici.com:465
SMTP_URL=
POSTA_GONDEREN="Sanal Türkiye <bildirim@sanalturkiye.ornek.com>"

# Önerilen: web push anahtarları (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_KONU=mailto:destek@sanalturkiye.ornek.com

# İsteğe bağlı: yapay zekâ (Claude; mahalle gazetesi, tarla danışmanı, moderasyon ön taraması). Boşsa kural tabanlı yedek çalışır.
# Kullanılırsa KVKK metninde yurt dışına aktarım belirtilmeli (docs/hukuk-kontrol-listesi.md).
ANTHROPIC_API_KEY=
# YAPAY_ZEKA=kapali
# YZ_MODEL=claude-opus-5-5

# İsteğe bağlı: Google / Apple ile giriş (docs/giris-yollari.md). Boşsa o yol kapalıdır.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# İsteğe bağlı: telefon doğrulama (SMS). TELEFON_ZORUNLU=1 ise değer aktaran işlemler doğrulanmış telefon ister.
# SMS_SAGLAYICI=netgsm
# NETGSM_KULLANICI=
# NETGSM_SIFRE=
# NETGSM_BASLIK=
# TELEFON_ZORUNLU=1

# İsteğe bağlı: hava (open-meteo | kapali; ticari kullanımda Open-Meteo aboneliği gerekir), nüfus (kapali ile demo sakinler
# devre dışı), kendi karo sunucusu (docs/karo-sunucusu.md)
# HAVA_KAYNAGI=open-meteo
# NUFUS=kapali
# VEKTOR_TILEJSON=https://karo.sanalturkiye.ornek.com/turkiye
# HARF_KARO=https://karo.sanalturkiye.ornek.com/fonts/{fontstack}/{range}.pbf
# YUKSELTI_KARO=https://karo.sanalturkiye.ornek.com/terrarium/{z}/{x}/{y}.png      (tarayıcının 3B arazisi)
# YUKSELTI_KAYNAGI=https://karo.sanalturkiye.ornek.com/terrarium/{z}/{x}/{y}.png   (sunucunun arsa konum değeri)
# EK_KARO_KOKENLERI=https://cdn.ornek.com
# TARLA_ILCELERI=42:Meram

# İsteğe bağlı: sınırlar ve günlük
# API_HIZ_SINIRI=600
# AGIR_HIZ_SINIRI=20
# WS_IP_SINIRI=8
# WS_TOPLAM_SINIRI=20000
# GUNLUK_DUZEYI=info

# Yalnızca geliştirme/test (üretimde KULLANMAYIN; açılış denetimi reddeder ya da uyarır):
# OTOMATIK_DOGRULA, YONETICI_2FA_ZORUNLU=0, KIMLIK_HIZ_CARPANI, KARO_KAYNAGI=sahte, HAVA_KAYNAGI=sahte, OYUN_HIZI,
# BAKIM_ARALIGI_MS=0, ONBELLEK=kapali, HATIRLATMA=kapali, MINI_ETKINLIK=kapali, SESSIZ, GUNLUK_SESSIZ
# Kaldırıldı (v0.47, etkisiz): SIYASET, SECIM_HIZI, SECIM_MIN_SECMEN, BELEDIYE_MIN_SECMEN
