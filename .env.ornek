# Sanal Türkiye — üretim ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp doldurun; .env depoya girmez.
NODE_ENV=production
PORT=3400
# docker-compose / Caddy için alan adı; TABAN_URL e-posta bağlantıları ve CSP için
ALAN_ADI=sanalturkiye.ornek.com
TABAN_URL=https://sanalturkiye.ornek.com
VERI_DIZINI=/veri

# Veritabanı. docker-compose PostgreSQL + PostGIS kullanır (VERITABANI ve DATABASE_URL compose dosyasında ayarlı);
# yalnızca parolayı burada verin (openssl rand -hex 24). Docker'sız kurulumda: VERITABANI=postgres ve
# DATABASE_URL=postgres://kullanici:parola@sunucu:5432/veritabani. VERITABANI=sqlite (varsayılan) tek sunucu içindir.
POSTGRES_PAROLA=
# VERITABANI=postgres
# DATABASE_URL=postgres://sanalturkiye:parola@127.0.0.1:5432/sanalturkiye
# PG_HAVUZ=10        # örnek başına bağlantı havuzu
# PG_SEMA=           # tabloları ayrı bir Postgres şemasında tut (varsayılan: public)

# Zorunlu: 2FA sırlarını şifreleyen anahtar (openssl rand -hex 32). Kaybedilirse 2FA kurulumları çözülemez; ayrı ve güvenli saklayın.
SIFRELEME_ANAHTARI=

# Zorunlu: e-posta (doğrulama, parola sıfırlama). Örnek: smtps://kullanici:parola@smtp.saglayici.com:465
SMTP_URL=
POSTA_GONDEREN="Sanal Türkiye <bildirim@sanalturkiye.ornek.com>"

# Önerilen: web push anahtarları (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_KONU=mailto:destek@sanalturkiye.ornek.com

# İsteğe bağlı: yapay zekâ (Claude). Boşsa kural tabanlı yedek çalışır.
ANTHROPIC_API_KEY=
# YAPAY_ZEKA=kapali

# İsteğe bağlı: hava (open-meteo | kapali), nüfus (kapali ile demo sakinler devre dışı), kendi karo sunucusu
# HAVA_KAYNAGI=open-meteo
# NUFUS=kapali
# VEKTOR_TILEJSON=https://karo.sanalturkiye.ornek.com/turkiye
# API_HIZ_SINIRI=600
# GUNLUK_DUZEYI=info
