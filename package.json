{
  "name": "sanal-turkiye",
  "version": "0.9.0",
  "private": true,
  "description": "Sanal Türkiye — yaşayan dijital ülke simülasyonu (prototip)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "SECIM_HIZI=1440 SECIM_MIN_SECMEN=1 BELEDIYE_MIN_SECMEN=1 node --watch server/index.js",
    "veri": "node server/veri/hazirla.js",
    "reset-db": "rm -f data/sanalturkiye-tr.db data/sanalturkiye-tr.db-shm data/sanalturkiye-tr.db-wal && node server/seed.js",
    "test": "node --test test/*.test.js",
    "rol": "node scripts/rol-ver.js",
    "yedek": "node scripts/yedek.js",
    "geri-yukle": "node scripts/geri-yukle.js",
    "yuk-testi": "node scripts/yuk-testi.js",
    "postgres-aktar": "node scripts/postgres-aktar.js",
    "posta-dene": "node scripts/posta-dene.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@mapbox/vector-tile": "^2.0.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "maplibre-gl": "^6.15.0",
    "nodemailer": "^10.1.7",
    "pbf": "^4.0.2",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-postgis": "^0.2.10",
    "smtp-server": "^3.20.2"
  }
}
